# Build with Node.js
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .

# Recibimos la variable desde el docker-compose y la exponemos a Vite
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# Lightweight web server with Nginx
FROM nginx:alpine
# Copy the build generated by Vite 
COPY --from=build /app/dist /usr/share/nginx/html
# Override Nginx's default configuration with ours
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]